datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CardOrder {
  id              String   @id @default(cuid())
  stripeSessionId String   @unique
  paid            Boolean  @default(false)
  recipientName   String
  message         String
  cardType        String
  shareId         String   @unique @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Card {
  id            String @id @default(uuid())
  shareId       String @unique
  cardKey       String
  recipientName String
  message       String

  stripeSessionId     String?
  stripeCustomerEmail String?

  treeCertificateUrl String?
  treeId             String?
  treeSpecies        String?
  treeLocation       String?
  treeDatePlanted    DateTime?

  emailSent Boolean @default(false)

  rsvps PartyRsvp[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shareId])
  @@index([stripeSessionId])
}

/// A guest's reply to a Kids birthday invite. Holds only a first name and
/// yes/no; ipHash (a keyed hash, never the raw IP) exists for rate limiting and
/// is cleared after a day. Rows are deleted by the daily cleanup cron.
model PartyRsvp {
  id        String   @id @default(uuid())
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  guestName String
  attending Boolean
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([cardId, createdAt])
  @@index([ipHash, createdAt])
  @@index([createdAt])
}
